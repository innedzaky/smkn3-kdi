# Salin file ini menjadi ".env.local" lalu sesuaikan dengan kredensial MySQL Anda

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smkn3_kdi

# URL situs (dipakai untuk metadata Open Graph)
NEXT_PUBLIC_SITE_URL=https://smkn3kdi.sch.id

# Kunci rahasia untuk menandatangani sesi login Panel Admin CMS.
# WAJIB diganti dengan string acak panjang saat deploy ke production.
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
